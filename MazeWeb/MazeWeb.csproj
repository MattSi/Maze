<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The original Graph library predates nullable reference types. -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8767</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.19" PrivateAssets="all" />
  </ItemGroup>

  <!-- Reuse the original Graph library source as-is.
       DisjSet.cs lives in a lowercase "graph" folder, which only matters on case-sensitive file systems. -->
  <ItemGroup>
    <Compile Include="..\Graph\*.cs" Link="Graph\%(Filename)%(Extension)" />
    <Compile Remove="..\Graph\DisjSet.cs" />
    <Compile Include="..\graph\DisjSet.cs" Link="Graph\DisjSet.cs" />
  </ItemGroup>

</Project>
